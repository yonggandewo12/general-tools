{
  "name": "general-tools-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for HTML/Markdown/PDF conversion, OCR, PPT generation, AI image generation, and document-to-Markdown conversion",
  "type": "module",
  "bin": {
    "general-tools-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts/ppt-master",
    "scripts/excel"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "setup:python": "pip install -r scripts/ppt-master/requirements.txt"
  },
  "keywords": [
    "mcp",
    "html",
    "pdf",
    "puppeteer",
    "converter",
    "ppt",
    "pptx",
    "presentation",
    "markdown",
    "ocr",
    "image-generation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@firecrawl/anydoc": "^0.1.9",
    "@firecrawl/pdf-inspector": "^1.15.0",
    "@llamaindex/liteparse": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "puppeteer": "^23.11.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-anchor": "^4.0.4",
    "@types/node": "^22.10.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
